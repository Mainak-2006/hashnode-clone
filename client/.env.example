# Client environment variables
# Copy this file to .env only if you need to override the defaults.

# Base URL for API requests.
# Leave unset during development to use the Vite proxy (/api -> http://localhost:5000).
# In production, set this to your deployed API origin, e.g. https://api.example.com/api
# VITE_API_URL=http://localhost:5000/api

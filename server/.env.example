# Server environment variables
# Copy this file to .env and fill in the values.

# development | production
NODE_ENV=development

# Port for the Express API
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/hashnode-clone

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Token lifetime (any jsonwebtoken duration string)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
# Development example: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: run an in-memory MongoDB for local demos/tests.
# Set to true only when you do not have MongoDB running locally.
# Data is lost when the server stops.
USE_MEMORY_DB=false
